BOT_TOKEN=
# Local Compose uses sslmode=disable. Hosted Postgres should use TLS
# (sslmode=require, or the vendor URL as issued). Do not commit production URLs.
DATABASE_URL=postgres://finbot:finbot@127.0.0.1:5432/finbot?sslmode=disable
# Local Compose. Hosted Redis may be rediss:// or the vendor URL as issued.
REDIS_URL=redis://:finbot@127.0.0.1:6379/0
LOG_LEVEL=info
# Go duration. Default 168h (7 days). 0 = no trial. Negative is invalid.
TRIAL_DURATION=168h
# Telegram user id that receives /feedback. Empty = /feedback unavailable.
ADMIN_TELEGRAM_ID=
# ISO-ish code stored on new banks. Empty = USD. Not shown in chat yet.
DEFAULT_CURRENCY=USD
