BOT_TOKEN=botfather-token
# Host `ENVFILE=.env go run ./cmd/bot` uses these URLs (Compose published ports).
# `make up` injects in-compose hostnames for the bot container and ignores these two.
# Hosted Postgres should use TLS (sslmode=require, or the vendor URL as issued).
DATABASE_URL=postgres://finbot:finbot@127.0.0.1:5432/finbot?sslmode=disable
# Local Compose. Hosted Redis may be rediss:// or the vendor URL as issued.
REDIS_URL=redis://:finbot@127.0.0.1:6379/0
# Sliding FSM TTL (BOT_TTL). Default 1h. Go duration.
BOT_TTL=1h
LOG_LEVEL=info
# Go duration. Default 168h (7 days). 0 = no trial. Negative is invalid.
TRIAL_DURATION=168h
# Telegram user id that receives /feedback. Empty = /feedback unavailable.
ADMIN_TELEGRAM_ID=
# ISO-ish code stored on new banks. Empty = USD. Not shown in chat yet.
DEFAULT_CURRENCY=USD
