BOT_TOKEN=
DATABASE_URL=postgres://finbot:finbot@127.0.0.1:5432/finbot?sslmode=disable
LOG_LEVEL=info
# Go duration. Default 168h (7 days). 0 = no trial. Negative is invalid.
TRIAL_DURATION=168h
# Telegram user id that receives /feedback. Empty = /feedback unavailable.
ADMIN_TELEGRAM_ID=
# ISO-ish code stored on new banks. Empty = USD. Not shown in chat yet.
DEFAULT_CURRENCY=USD
